# ── Downstream service URLs (Render URLs after deployment) ─────────────────
AUTH_SERVICE_URL=
CATALOG_SERVICE_URL=
INVENTORY_SERVICE_URL=
ORDER_SERVICE_URL=
CART_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
PAYMENT_SERVICE_URL=
RECOMMENDATION_SERVICE_URL=

# ── Auth ───────────────────────────────────────────────────────────────────
# Must match JWT_SECRET in auth-service exactly
JWT_SECRET=

# ── Gateway config ─────────────────────────────────────────────────────────
# Allowed CORS origin (Vercel frontend URL)
FRONTEND_URL=

# Max requests per minute per IP (default: 60)
RATE_LIMIT_RPM=60

# Port to listen on (default: 8000)
PORT=8000
